{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/player1314520/defense-tracker-mvp/raw/main/release/publisher-policy.schema.json",
  "title": "DefenseTracker stable Windows Publisher policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "status",
    "publisher",
    "active_provider",
    "providers"
  ],
  "properties": {
    "$schema": { "const": "./publisher-policy.schema.json" },
    "schema_version": { "const": 1 },
    "status": { "enum": ["pending", "approved"] },
    "publisher": { "type": ["string", "null"], "minLength": 1 },
    "active_provider": {
      "enum": [null, "AzureArtifactSigning", "DigiCertKeyLocker"]
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AzureArtifactSigning", "DigiCertKeyLocker"],
      "properties": {
        "AzureArtifactSigning": { "$ref": "#/$defs/azure" },
        "DigiCertKeyLocker": { "$ref": "#/$defs/digicert" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pending" } } },
      "then": {
        "properties": {
          "publisher": { "type": "null" },
          "active_provider": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": {
        "properties": {
          "publisher": { "type": "string", "minLength": 1 },
          "active_provider": {
            "enum": ["AzureArtifactSigning", "DigiCertKeyLocker"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "active_provider": { "const": "AzureArtifactSigning" } }
      },
      "then": {
        "properties": {
          "providers": {
            "properties": {
              "AzureArtifactSigning": {
                "properties": { "status": { "const": "approved" } }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "active_provider": { "const": "DigiCertKeyLocker" } }
      },
      "then": {
        "properties": {
          "providers": {
            "properties": {
              "DigiCertKeyLocker": {
                "properties": { "status": { "const": "approved" } }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "status": { "enum": ["pending", "approved"] },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "names": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "hashes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "azure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "endpoint",
        "account_name",
        "certificate_profile_name",
        "expected_subjects",
        "expected_issuers",
        "expected_root_sha256",
        "durable_identity_eku",
        "public_trust_eku",
        "code_signing_eku",
        "forbidden_test_eku",
        "leaf_spki_policy"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "endpoint": { "type": ["string", "null"], "format": "uri" },
        "account_name": { "type": ["string", "null"], "minLength": 1 },
        "certificate_profile_name": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "expected_subjects": { "$ref": "#/$defs/names" },
        "expected_issuers": { "$ref": "#/$defs/names" },
        "expected_root_sha256": { "$ref": "#/$defs/hashes" },
        "durable_identity_eku": {
          "type": ["string", "null"],
          "pattern": "^1\\.3\\.6\\.1\\.4\\.1\\.311\\.97\\.[0-9]+(?:\\.[0-9]+)+$"
        },
        "public_trust_eku": { "const": "1.3.6.1.4.1.311.97.1.0" },
        "code_signing_eku": { "const": "1.3.6.1.5.5.7.3.3" },
        "forbidden_test_eku": { "const": "1.3.6.1.4.1.311.10.3.13" },
        "leaf_spki_policy": { "const": "record-only" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "pending" } } },
          "then": {
            "properties": {
              "endpoint": { "type": "null" },
              "account_name": { "type": "null" },
              "certificate_profile_name": { "type": "null" },
              "expected_subjects": { "maxItems": 0 },
              "expected_issuers": { "maxItems": 0 },
              "expected_root_sha256": { "maxItems": 0 },
              "durable_identity_eku": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "approved" } } },
          "then": {
            "properties": {
              "endpoint": { "type": "string", "format": "uri" },
              "account_name": { "type": "string", "minLength": 1 },
              "certificate_profile_name": { "type": "string", "minLength": 1 },
              "expected_subjects": { "minItems": 1 },
              "expected_issuers": { "minItems": 1 },
              "expected_root_sha256": { "minItems": 1 },
              "durable_identity_eku": {
                "type": "string",
                "pattern": "^1\\.3\\.6\\.1\\.4\\.1\\.311\\.97\\.[0-9]+(?:\\.[0-9]+)+$"
              }
            }
          }
        }
      ]
    },
    "digicert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sm_host",
        "key_alias",
        "certificate_file_sha256",
        "expected_subjects",
        "expected_spki_sha256",
        "expected_issuers",
        "expected_root_sha256",
        "code_signing_eku",
        "leaf_spki_policy"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "sm_host": { "type": ["string", "null"], "format": "uri" },
        "key_alias": { "type": ["string", "null"], "minLength": 1 },
        "certificate_file_sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "expected_subjects": { "$ref": "#/$defs/names" },
        "expected_spki_sha256": { "$ref": "#/$defs/hashes" },
        "expected_issuers": { "$ref": "#/$defs/names" },
        "expected_root_sha256": { "$ref": "#/$defs/hashes" },
        "code_signing_eku": { "const": "1.3.6.1.5.5.7.3.3" },
        "leaf_spki_policy": { "const": "required-pin" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "pending" } } },
          "then": {
            "properties": {
              "sm_host": { "type": "null" },
              "key_alias": { "type": "null" },
              "certificate_file_sha256": { "type": "null" },
              "expected_subjects": { "maxItems": 0 },
              "expected_spki_sha256": { "maxItems": 0 },
              "expected_issuers": { "maxItems": 0 },
              "expected_root_sha256": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "approved" } } },
          "then": {
            "properties": {
              "sm_host": { "type": "string", "format": "uri" },
              "key_alias": { "type": "string", "minLength": 1 },
              "certificate_file_sha256": { "$ref": "#/$defs/sha256" },
              "expected_subjects": { "minItems": 1 },
              "expected_spki_sha256": { "minItems": 1 },
              "expected_issuers": { "minItems": 1 },
              "expected_root_sha256": { "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
