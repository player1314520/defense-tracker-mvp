# Merge these non-secret values into the .env supplied by the PINNED official
# Supabase self-hosted release. Generate all upstream secrets independently;
# never copy sample JWT/password/SMTP values into production.
# The production override replaces these published ports. They still must be
# syntactically valid because Compose expands the official base file first.
KONG_HTTP_PORT=18000
KONG_HTTPS_PORT=18443
SITE_URL=https://portal.example.invalid/portal/
ADDITIONAL_REDIRECT_URLS=https://portal.example.invalid/portal/,http://127.0.0.1:49231/api/v9/auth/callback,http://127.0.0.1:49232/api/v9/auth/callback,http://127.0.0.1:49233/api/v9/auth/callback,http://127.0.0.1:49234/api/v9/auth/callback,http://127.0.0.1:49235/api/v9/auth/callback
API_EXTERNAL_URL=https://api.example.invalid/auth/v1
SUPABASE_PUBLIC_URL=https://api.example.invalid
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_EMAIL_AUTOCONFIRM=false

# The two deployed functions validate authenticated actions themselves so the
# access application endpoint can accept its anonymous `apply` action.
FUNCTIONS_VERIFY_JWT=false

# Generate independent random 32-byte base64url values.  These remain only in
# the root-owned official Supabase .env and are never mounted into the Portal.
ACCESS_APPLICATION_HMAC_KEY=REPLACE_WITH_BASE64URL_32_BYTES
ACCESS_APPLICATION_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_BASE64URL_32_BYTES
ACCESS_APPLICATION_ENCRYPTION_KEY_VERSION=1

# Generate these with the pinned official Supabase key tooling. The Portal gets
# only SUPABASE_PUBLISHABLE_KEY; SUPABASE_SECRET_KEY remains server-side.
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_GENERATED_OPAQUE_PUBLISHABLE_KEY
SUPABASE_PUBLISHABLE_KEYS={"default":"REPLACE_WITH_GENERATED_OPAQUE_PUBLISHABLE_KEY"}
SUPABASE_SECRET_KEY=REPLACE_WITH_GENERATED_OPAQUE_SECRET_KEY

# Custom SMTP is mandatory before invitations are enabled.
SMTP_ADMIN_EMAIL=replace-with-sender@example.invalid
SMTP_HOST=replace-with-smtp-host.example.invalid
SMTP_PORT=587
SMTP_USER=REPLACE_IN_ROOT_OWNED_UPSTREAM_ENV
SMTP_PASS=REPLACE_IN_ROOT_OWNED_UPSTREAM_ENV
SMTP_SENDER_NAME=DefenseTracker
