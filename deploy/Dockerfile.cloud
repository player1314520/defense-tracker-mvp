FROM python:3.11-slim

WORKDIR /app

COPY deploy/requirements.cloud.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY v9_cloud.py ./
COPY v9/__init__.py v9/cloud.py ./v9/
COPY web/v9-portal ./web/v9-portal

RUN useradd -m -u 1000 appuser \
    && mkdir -p /data \
    && chown -R appuser:appuser /app /data
USER appuser

ENV PYTHONUNBUFFERED=1 PORT=8080 V9_PRODUCTION_MODE=true

EXPOSE 8080

CMD ["gunicorn", "--workers", "1", "--threads", "4", "--bind", "0.0.0.0:8080", "--timeout", "30", "--graceful-timeout", "15", "--access-logfile", "-", "v9_cloud:app"]
